# Copy this file to .env and fill in the values.
# The .env file is gitignored so secrets stay on your machine.

# SearXNG signing key. Required when binding to anything other than localhost.
# Always overrides the placeholder in searxng/config/settings.yml, even when
# empty, so set it here (an empty value means SearXNG runs with no key).
# Generate with one of:
#   PowerShell: $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
#   Node:       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl:    openssl rand -hex 32
SEARXNG_SECRET=

# Host interface SearXNG binds to. Default 127.0.0.1 (this machine only).
# Set to 0.0.0.0 to reach it over LAN or Tailscale -- do that here rather than
# editing docker-compose.yml, so `git pull` never conflicts with your setup.
# Exposing SearXNG makes SEARXNG_SECRET mandatory; see ADVANCED.md.
SEARXNG_BIND=127.0.0.1

# Host interface the MCP server binds to. Default 0.0.0.0 so remote MCP clients
# can connect. Set to 127.0.0.1 to restrict it to this machine.
MCP_BIND=0.0.0.0

# Browser-based MCP clients (anything that sends an Origin header) get HTTP 403
# unless their exact origin (scheme, host, port) is listed here. Empty = only
# http(s)://localhost, 127.0.0.1 and [::1] on :3001 or no port. A non-empty list
# REPLACES those defaults. Clients without an Origin (Claude Code, SDKs, curl)
# are not affected.
MCP_ALLOWED_ORIGINS=
