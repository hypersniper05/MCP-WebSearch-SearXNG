# Copy this file to .env and fill in the values.
# The .env file is gitignored so secrets stay on your machine.

# SearXNG signing key. Required when binding to anything other than localhost.
# Overrides the placeholder in searxng/config/settings.yml.
# Generate with one of:
#   PowerShell: [System.BitConverter]::ToString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).Replace('-','').ToLower()
#   Node:       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl:    openssl rand -hex 32
SEARXNG_SECRET=

# Set to "true" to serve everything over HTTPS instead of HTTP.
# When enabled, Caddy is added to the stack as a reverse proxy that auto-generates
# a self-signed certificate. Same ports stay in use (8888 for SearXNG, 3001 for MCP) —
# only the protocol changes from http:// to https://.
# Use the bundled `mcp` wrapper instead of `docker compose` so this toggle is honored:
#     mcp up -d        (Windows: mcp.cmd, Unix: ./mcp.sh)
# Self-signed cert needs to be trusted on each client — see README "HTTPS" section.
MCP_HTTPS=false
